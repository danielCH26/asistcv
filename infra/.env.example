# Database configuration
POSTGRES_USER=asistcv
POSTGRES_PASSWORD=asistcv
POSTGRES_DB=asistcv
# The db service in docker-compose.yml publishes host port 5433 -> container
# 5432. Backend Settings.database_url matches this host port by default.
DATABASE_URL=postgresql+psycopg://asistcv:asistcv@localhost:5433/asistcv
