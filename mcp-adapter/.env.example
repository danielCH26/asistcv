# Backend AsistCV (FastAPI)
# Production: https://asistcv-backend.onrender.com
# Override for local dev with `BACKEND_URL=http://localhost:8000`.
BACKEND_URL=https://asistcv-backend.onrender.com

# Optional: API key for backend authentication.
# Required when the backend runs with BACKEND_API_KEY set (PR-B).
# Leave commented out when the backend is in open mode (no key configured).
# BACKEND_API_KEY=your-api-key-here

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# HTTP timeout for backend calls (seconds).
# Default 60.0 to absorb Render cold starts (30-50s on the free tier).
TIMEOUT_SECONDS=60.0

# Web search provider for the `web_search` MCP tool (issue #59).
# Only "tavily" is supported in v1.0; other values make the tool raise.
WEB_SEARCH_PROVIDER=tavily

# Tavily API key — get one at https://tavily.com (free tier available).
# Without it, the web_search tool raises a clear ValueError on every call.
# NEVER commit a real key — env only.
# TAVILY_API_KEY=tvly-your-key-here
