# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# API Configuration
API_PREFIX=/v1

# Database (optional for Sprint 0, required for Sprint 4)
# DATABASE_URL=postgresql://user:password@localhost:5432/asistcv

# LLM Provider (mock|vertex)
LLM_PROVIDER=mock

# Backend API Key (optional, for MCP adapter)
# BACKEND_API_KEY=your_api_key_here

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:8000
