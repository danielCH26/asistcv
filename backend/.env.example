# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# API Configuration
API_PREFIX=/v1

# Database (PostgreSQL with pgvector)
# Use postgresql+psycopg:// for sync or postgresql+asyncpg:// for async
DATABASE_URL=postgresql://asistcv:asistcv@localhost:5433/asistcv

# Test database — the suite DROPS the public schema and TRUNCATEs ~20 tables
# (users, payments, audit_uploads, ...) on it. A guard in tests/conftest.py
# aborts the run unless the target is provably disposable, so the local Docker
# path keeps working with no setup. The guard reads the real environment, NOT
# this file: pydantic-settings loads .env into Settings only and never populates
# os.environ, so a value here would not be seen. Export it in the shell or set
# it as a CI env var.
#
# Optional, only needed for a REMOTE test database (e.g. a disposable Neon
# branch). Without it the guard refuses any host that is not loopback.
# ALLOW_REMOTE_TEST_DATABASE=1
#
# To point the suite at a remote branch, set a database name containing "test"
# (the guard rejects names it cannot read as disposable, such as "neondb" or
# "asistcv") and keep DATABASE_URL pointing elsewhere: if TEST_DATABASE_URL and
# DATABASE_URL resolve to the same host + port + database + user, the guard
# refuses and there is no flag to override that.
# TEST_DATABASE_URL=postgresql://USER:PASS@ep-xxx.us-east-2.aws.neon.tech/asistcv_test

# LLM Provider options:
# - mock: Mock provider for development (no API keys needed)
# - groq: Groq for LLM + HuggingFace for embeddings (requires API keys)
# - huggingface: HuggingFace for embeddings only (LLM not supported)
LLM_PROVIDER=mock

# Groq configuration (required when LLM_PROVIDER=groq)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# HuggingFace configuration (required when LLM_PROVIDER=groq or huggingface)
# Get your token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here
HF_EMBEDDING_MODEL=BAAI/bge-m3

# Backend API Key (optional, for MCP adapter)
# Also guards the internal cleanup sweepers (POST /internal/*/cleanup) —
# those fail closed (401) when the key is unset.
# BACKEND_API_KEY=your_api_key_here

# Refresh-token retention sweep (POST /internal/auth/refresh-tokens/cleanup).
# Consumed/revoked rows are audit evidence, not active state, so the window
# is sized for incident response. Active tokens are never deleted, so raising
# this value can never shorten a live session. Defaults to 90 (a quarter).
# REFRESH_TOKEN_RETENTION_DAYS=90

# JWT signing key (REQUIRED — the backend refuses to start without it)
# The built-in fallback is a literal published in this repo's history, so it is
# rejected at startup and there is no development exemption. Generate a real
# key and uncomment the line:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# CORS origins — must be a JSON array STRING (not CSV, pydantic-settings parses as JSON):
# Examples:
#   Local dev only:            CORS_ORIGINS='["http://localhost:5173","http://localhost:8000"]'
#   Local + Cloudflare Pages:  CORS_ORIGINS='["http://localhost:5173","http://localhost:8000","https://asistcv-frontend.pages.dev"]'
#   Production only:           CORS_ORIGINS='["https://asistcv-frontend.pages.dev"]'
# Wildcard (dev only, never in production):
#   CORS_ORIGINS='["*"]'
CORS_ORIGINS='["http://localhost:5173","http://localhost:8000"]'
