# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL with pgvector)
# Use postgresql+psycopg:// for sync or postgresql+asyncpg:// for async
DATABASE_URL=postgresql://asistcv:asistcv@localhost:5433/asistcv

# Test database — the suite DROPS the public schema and TRUNCATEs ~20 tables
# (users, payments, audit_uploads, ...) on it. A guard in tests/conftest.py
# aborts the run unless the target is provably disposable, so the local Docker
# path keeps working with no setup. The guard reads the real environment, NOT
# this file: pydantic-settings loads .env into Settings only and never populates
# os.environ, so a value here would not be seen. Export it in the shell or set
# it as a CI env var.
#
# Optional, only needed for a REMOTE test database (e.g. a disposable Neon
# branch). Without it the guard refuses any host that is not loopback.
# ALLOW_REMOTE_TEST_DATABASE=1
#
# To point the suite at a remote branch, set a database name containing "test"
# (the guard rejects names it cannot read as disposable, such as "neondb" or
# "asistcv") and keep DATABASE_URL pointing elsewhere: if TEST_DATABASE_URL and
# DATABASE_URL resolve to the same host + port + database + user, the guard
# refuses and there is no flag to override that.
# TEST_DATABASE_URL=postgresql://USER:PASS@ep-xxx.us-east-2.aws.neon.tech/asistcv_test

# LLM Provider options:
# - mock: Mock provider for development (no API keys needed)
# - groq: Groq for LLM + HuggingFace for embeddings (requires API keys)
# - huggingface: HuggingFace for embeddings only (LLM not supported)
LLM_PROVIDER=mock

# Groq configuration (required when LLM_PROVIDER=groq)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# HuggingFace configuration (required when LLM_PROVIDER=groq or huggingface)
# Get your token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here
HF_EMBEDDING_MODEL=BAAI/bge-m3

# Backend API Key (optional, for MCP adapter)
# Also guards the internal cleanup sweepers (POST /internal/*/cleanup) —
# those fail closed (401) when the key is unset.
# BACKEND_API_KEY=your_api_key_here

# Refresh-token retention sweep (POST /internal/auth/refresh-tokens/cleanup).
# Consumed/revoked rows are audit evidence, not active state, so the window
# is sized for incident response. Active tokens are never deleted, so raising
# this value can never shorten a live session. Defaults to 90 (a quarter).
# REFRESH_TOKEN_RETENTION_DAYS=90

# JWT signing key (REQUIRED — the backend refuses to start without it)
# The built-in fallback is a literal published in this repo's history, so it is
# rejected at startup and there is no development exemption. Generate a real
# key and uncomment the line:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# CORS origins — must be a JSON array STRING (not CSV, pydantic-settings parses as JSON):
# Examples:
#   Local dev only:            CORS_ORIGINS='["http://localhost:5173","http://localhost:8000"]'
#   Local + Cloudflare Pages:  CORS_ORIGINS='["http://localhost:5173","http://localhost:8000","https://asistcv-frontend.pages.dev"]'
#   Production only:           CORS_ORIGINS='["https://asistcv-frontend.pages.dev"]'
# Wildcard (dev only, never in production):
#   CORS_ORIGINS='["*"]'
CORS_ORIGINS='["http://localhost:5173","http://localhost:8000"]'

# Email delivery (verify-email flow, issue #46 / C3).
# Provider: ``resend`` is the only one wired today; ``sendgrid`` and
# ``smtp`` are reserved names for future branches. Anything other than
# ``resend`` is logged and skipped — never raises into the request.
EMAIL_PROVIDER=resend
# Resend API key. Get one at https://resend.com/api-keys (3000 emails/month
# free tier). Empty / blank → service logs ``email_service_disabled`` and
# returns False from send_email; the request itself still succeeds and the
# verification token row is persisted, so the link can be read from logs
# in dev. NEVER commit a real key — env only.
RESEND_API_KEY=
# From-address used in the verification email. Resend requires the domain
# to be verified before any non-default value works, so keep this as
# ``noreply@asistcv.com`` until the domain is set up in the Resend dashboard.
EMAIL_FROM=AsistCV <noreply@asistcv.com>
# Token lifetime (seconds). 86400 = 24h. Tokens past their expiry return
# 400 INVALID_TOKEN on confirm.
EMAIL_VERIFICATION_TTL_SECONDS=86400

# ----------------------------------------------------------------------------
# Application identity (informational — overrides only matter for branding)
# ----------------------------------------------------------------------------
APP_NAME=AsistCV Backend

# ----------------------------------------------------------------------------
# Adaptation kill-switch (Sprint 3 Slice A PR1 + PR2)
# ----------------------------------------------------------------------------
# When False, POST /v1/adaptations short-circuits with a 503 FEATURE_DISABLED
# response without invoking the LLM. Useful for staged rollouts or for pausing
# the feature in production without redeploying. Defaults to False.
ADAPTATION_ENABLED=False

# ----------------------------------------------------------------------------
# Audit cleanup token
# ----------------------------------------------------------------------------
# Required for ``POST /internal/audit/cleanup`` and other internal sweepers.
# Each request must match this value or it returns 401. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set in the Render environment, NEVER commit a real value.
# AUDIT_CLEANUP_TOKEN=

# ----------------------------------------------------------------------------
# Frontend URL (used for verify-email links and CORS defaults)
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# JWT configuration
# ----------------------------------------------------------------------------
# Algorithm used to sign access + refresh tokens. Only HS256 is supported today.
JWT_ALGORITHM=HS256
# Access token lifetime (seconds). 900 = 15 minutes.
JWT_ACCESS_TTL=900
# Refresh token lifetime (seconds). 2592000 = 30 days. The absolute-expiry
# fix (PR #69) makes the rotated row inherit the presented row's expires_at,
# so this value only affects first-issue tokens.
JWT_REFRESH_TTL=2592000

# ----------------------------------------------------------------------------
# Retrieval tuning (PR-C, issue #16)
# ----------------------------------------------------------------------------
# Threshold (chars) above which the profile is split into fragments for
# semantic retrieval. 3000 covers most CVs without forcing a split.
RETRIEVAL_SIZE_THRESHOLD_CHARS=3000
# Number of fragments returned for each match request.
RETRIEVAL_TOP_K=8
# Target fragment size (chars) when splitting large profiles.
RETRIEVAL_FRAGMENT_TARGET_CHARS=500

# ----------------------------------------------------------------------------
# Stripe billing (PR5 + issue #35)
# ----------------------------------------------------------------------------
# Set in the Render environment. NEVER commit a real key.
# STRIPE_SECRET_KEY=
# Set in the Render environment. NEVER commit a real value.
# STRIPE_WEBHOOK_SECRET=
# Price IDs for the four subscription tiers. Look these up in the Stripe
# dashboard under Products → Pricing. Placeholders are not valid in production.
STRIPE_PRICE_JOB_SEEKER_MONTHLY=price_job_seeker_monthly
STRIPE_PRICE_RECRUITER_STARTER=price_recruiter_starter
STRIPE_PRICE_RECRUITER_BUSINESS=price_recruiter_business
STRIPE_PRICE_RECRUITER_AGENCY=price_recruiter_agency
